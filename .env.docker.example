# Copy to .env next to docker-compose.yml, then fill in APP_KEY:
#
#   docker run --rm jez500/prompt-queue php artisan key:generate --show
#
# (Plain `docker run`, not `docker compose run` — compose evaluates the
# APP_KEY guard on every subcommand, so it can't generate its own key.)

APP_NAME="Prompt Queue"
APP_KEY=
APP_URL=http://localhost:8080

# Host port the app is published on.
APP_PORT=8080

# Password resets are the only outgoing mail. Leave as `log` to disable them
# (reset links are written to the container log instead of being sent).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
